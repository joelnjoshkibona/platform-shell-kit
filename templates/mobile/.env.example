# The {{PRODUCT_NAME}} phone app (P93). Copy to .env, then `php artisan key:generate`.
# The app's own Laravel serves the interface and does the phone's own work (device, drafts, log, cache); the product's data lives on the
# {{PRODUCT_NAME}} API ({{PRODUCT_SLUG_UPPER}}_API_URL below), which the interface calls directly.
APP_NAME={{PRODUCT_NAME}}
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# The API the interface talks to, baked in by scripts/build-web.sh. Production by default; for the emulator
# against `php artisan serve` in api/ use http://localhost:8000/api with `adb reverse tcp:8000 tcp:8000`
# (never 127.0.0.1: inside the app that is the app's own server).
{{PRODUCT_SLUG_UPPER}}_API_URL=https://{{DOMAIN}}/api

# NativePHP. Bump both for every build that must reach a phone: the same version keeps the old bundle (P68).
NATIVEPHP_APP_ID={{APP_ID}}
NATIVEPHP_APP_VERSION=0.1.0
NATIVEPHP_APP_VERSION_CODE=1
# Android 8 and above (owner, 17 Oct 2026); NativePHP's default is 33.
NATIVEPHP_ANDROID_MIN_SDK=26
# P102: connected (the API is the truth) · phone (all data on this phone) · sync (a working copy + a queue of changes)
APP_DATA_MODE=connected

# P79: the public download page (scripts/make-download-page.mjs) and what an update keeps, in the product's words
APP_TAGLINE="One line under the name on the download page."
APP_DATA_KEPT="Your data stays."

# P79: updates from a static page. Set APP_UPDATE_FEED for an app with no server of its own (APP_DATA_MODE=phone) or one
# that publishes on a download page: this app's own server reads it, never the interface. Empty: the product's API (P53).
# APP_DOWNLOAD_REPO is the page's GitHub repo (owner/{{PRODUCT_SLUG}}-download, Pages on), where scripts/release.sh publishes.
APP_UPDATE_FEED=
APP_DOWNLOAD_REPO=
