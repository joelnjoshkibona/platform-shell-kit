# The {{PRODUCT_NAME}} Android app ((the product's phone app decision)). Copy to .env, then `php artisan key:generate`.
# The app's own Laravel only serves the web build; the shop's data lives on the {{PRODUCT_NAME}} API ({{PRODUCT_SLUG_UPPER}}_API_URL below).
APP_NAME={{PRODUCT_NAME}}
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# The API the web build talks to, baked in by scripts/build-web.sh ((the product's phone app decision)). Production by default; for the emulator
# against `php artisan serve` in api/ use http://localhost:8000/api with `adb reverse tcp:8000 tcp:8000`
# (never 127.0.0.1: inside the app that is the app's own server).
{{PRODUCT_SLUG_UPPER}}_API_URL=https://{{DOMAIN}}/api

# NativePHP. Bump both for every build that must reach a phone: the same version keeps the old bundle ((the product's phone app decision)).
NATIVEPHP_APP_ID={{APP_ID}}
NATIVEPHP_APP_VERSION=0.1.0
NATIVEPHP_APP_VERSION_CODE=1
# Android 8 and above (owner, 17 Oct 2026); NativePHP's default is 33.
NATIVEPHP_ANDROID_MIN_SDK=26
